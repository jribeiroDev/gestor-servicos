# Copie para apps/cliente/.env.local e apps/admin/.env.local (valores reais).
# No Vercel, estas variáveis são configuradas em Settings → Environment Variables
# de cada projeto (ver DEPLOY.md).

# ---------------------------------------------------------------- Supabase
# Comuns às duas apps.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ATENÇÃO: chave secreta — ignora RLS. Só no servidor.
# NUNCA lhe dar o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ------------------------------------------------------------- Web push
# Gerar com: node -e "console.log(require('web-push').generateVAPIDKeys())"
# A chave pública é a MESMA nas duas apps; a privada é secreta.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@exemplo.pt

# ------------------------------------------------------- Só na app admin
# URL público da app cliente, usado nos links das notificações push.
NEXT_PUBLIC_CLIENTE_URL=http://localhost:3000
